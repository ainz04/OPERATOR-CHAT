# ==============================================================================
# FDI OPERATOR TERMINAL - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server port (defaults to 3000, or provided by hosting platform like Render/Railway)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=production

# Admin Level S Credentials
# Jika dikosongkan, server akan otomatis membuat password acak saat pertama kali start dan mencetaknya di log.
ADMIN_USERNAME=TANNER
ADMIN_PASSWORD=

# Durasi jendela akses komunikasi (dalam jam, default: 5)
ACCESS_WINDOW_HOURS=5

# Batas maksimal upload file dalam MB (default: 15)
MAX_FILE_MB=15

# Kunci Enkripsi Master AES-256-GCM (64 karakter hex / 32 bytes)
# Jika tidak disetel, server akan otomatis membuatnya dan menyimpannya di data/secrets.json
# MASTER_KEY=

# Secret JWT untuk penandatanganan sesi httpOnly
# JWT_SECRET=
